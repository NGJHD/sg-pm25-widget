<?xml version="1.0" encoding="utf-8"?>
<!--
  System-bar insets are added in code (SystemBars.pad) on main_root:
  android:fitsSystemWindows does not work under targetSdk 36 edge-to-edge, and
  it REPLACES a view's padding rather than adding to it. Do not re-add it.

  The Done button sits OUTSIDE the ScrollView, pinned to the bottom, and only
  shows during first-time setup (user, 10-13: it was missed below the fold).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/AppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <!-- Setup gate banner (battery Unrestricted, Data Saver). -->
        <TextView
            android:id="@+id/setup_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_warning"
            android:lineSpacingExtra="2dp"
            android:padding="14dp"
            android:textColor="@color/warning_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- The value the widget shows, in its band colour. -->
        <LinearLayout
            android:id="@+id/current_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_value"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/current_region"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/current_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/current_band"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/current_meta"
            style="@style/AppHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center" />

        <!-- While a fetch runs: spinner over the button's left edge, text
             "Refreshing…", button disabled (MainActivity.renderRefreshing). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_refresh"
                style="@style/AppButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refresh now" />

            <ProgressBar
                android:id="@+id/refresh_spinner"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="18dp"
                android:elevation="4dp"
                android:indeterminateTint="@color/on_accent"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="All regions" />

        <com.ngjhd.sgpm25widget.RegionMapView
            android:id="@+id/regions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="8dp" />

        <!-- Widget text size (user, 10-13): slider + a live preview of the
             real widget (its RemoteViews applied here), at the placed
             widget's size. -->
        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Widget text size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/widget_preview_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_preview_wallpaper"
                android:padding="10dp">

                <!-- No match_parent overlay here: a plain View measured AT_MOST
                     takes the whole width, which squeezed the slider column to
                     0 px. The preview's click handlers are removed in code. -->
                <FrameLayout
                    android:id="@+id/widget_preview"
                    android:layout_width="76dp"
                    android:layout_height="76dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_scale_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/text_scale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    style="@style/AppHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Text that does not fit is cut off - check the preview." />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/AppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Location" />

        <TextView
            android:id="@+id/location_status"
            style="@style/AppHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_location"
            style="@style/AppButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            style="@style/AppHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Values are the 1-hour PM2.5 concentration in µg/m³. Bands (NEA): 0–55 Normal, 56–150 Elevated, 151–250 High, 251 and above Very high.\n\nThe widget updates every hour at 20 minutes past, while the screen is on, and catches up when the phone wakes. Add it from your home screen's widget picker. Data: data.gov.sg." />

    </LinearLayout>
    </ScrollView>

    <!-- Only when opened by placing a widget; always on screen then. -->
    <Button
        android:id="@+id/btn_done"
        style="@style/AppButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:text="Done"
        android:visibility="gone" />
</LinearLayout>
